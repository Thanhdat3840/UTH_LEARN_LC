<div id="experiencefragment-8e49624313" class="cmp-experiencefragment cmp-experiencefragment--footer">


    
    <div id="container-df09fb231c" class="cmp-container">
        


<div class="aem-Grid aem-Grid--12 aem-Grid--default--12 ">
    
    <div class="htmlsourcedit aem-GridColumn aem-GridColumn--default--12">

    
    
        <script>
    /*
     logo SACOMBANK
     */
document.addEventListener('DOMContentLoaded', function () {
    const topSubList = document.querySelector('.footer__top-sub--list');
    if (topSubList) {
        const logoItem = document.createElement('li');
        logoItem.className = 'footer__top-sub--item';
        logoItem.innerHTML = `
            <a class="footer__top-sub--link" 
               href="/content/dam/sacombank/files/logo/Logo-bieu-tuong-thuong-hieu.pdf" 
               download="Logo-bieu-tuong-thuong-hieu.zip">
               
Logo SACOMBANK
            </a>
        `;
        topSubList.appendChild(logoItem);
    }
});
    /*
     logo DVI
     */
(function () {
    const ICON_ID = 'footer-extra-icon';

    const ICON_SRC =
        '/content/dam/sacombank/images/tin-tuc/2026/logo_DVI.png';

    const ICON_URL =
        'https://div.gov.vn/';

    const ICON_WIDTH = 75;

    function getLastPlatform() {
        const container = document.querySelector(
            '.footer__body-item--platform'
        );

        if (!container) {
            return null;
        }

        const platforms =
            container.querySelectorAll('.platform');

        if (!platforms.length) {
            return null;
        }

        return platforms[platforms.length - 1];
    }

    /*
     * Tính vị trí layout thật,
     * không bị ảnh hưởng bởi scale của AEM Emulator.
     */
    function getLayoutLeft(element) {
        let left = 0;
        let current = element;

        while (current) {
            left += current.offsetLeft || 0;
            current = current.offsetParent;
        }

        return left;
    }

    function alignIcon() {
        const platform = getLastPlatform();

        const extra =
            document.getElementById(ICON_ID);

        if (!platform || !extra) {
            return;
        }

        /*
         * DOM hiện tại:
         *
         * .platform__wrap
         *   ├── <a>
         *   │    └── picture APP
         *   └── picture QR
         */
        const qrPicture = platform.querySelector(
            '.platform__wrap > .platform__wrap-img:last-child'
        );

        if (!qrPicture) {
            return;
        }

        /*
         * Ưu tiên lấy img thật bên trong picture.
         */
        const qr =
            qrPicture.querySelector('img') ||
            qrPicture;

        /*
         * Vị trí layout, không dùng getBoundingClientRect().
         */
        const platformLeft =
            getLayoutLeft(platform);

        const qrLeft =
            getLayoutLeft(qr);

        const qrRight =
            qrLeft + qr.offsetWidth;

        /*
         * Mép phải DVI = mép phải QR
         */
        let left =
            qrRight -
            platformLeft -
            ICON_WIDTH;

        if (left < 0) {
            left = 0;
        }

        extra.style.marginLeft =
            `${left}px`;
    }

    function addFooterIcon() {
        const platform = getLastPlatform();

        if (!platform) {
            return false;
        }

        let extra =
            document.getElementById(ICON_ID);

        if (!extra) {
            extra =
                document.createElement('div');

            extra.id = ICON_ID;

            /*
             * QUAN TRỌNG:
             * Không chỉnh gì vào .platform__wrap.
             *
             * DVI chỉ là block mới bên dưới wrap.
             */
            extra.style.cssText = `
                display: block;
                width: ${ICON_WIDTH}px;
                margin-top: 10px;
                margin-right: 0;
                padding: 0;
                box-sizing: border-box;
            `;

            const link =
                document.createElement('a');

            link.href = ICON_URL;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';

            link.style.cssText = `
                display: block;
                width: ${ICON_WIDTH}px;
                margin: 0;
                padding: 0;
                line-height: 0;
                cursor: pointer;
            `;

            const img =
                document.createElement('img');

            img.src = ICON_SRC;
            img.alt = 'Chứng nhận';

            img.style.cssText = `
                display: block;
                width: ${ICON_WIDTH}px;
                max-width: none;
                height: auto;
                margin: 0;
                padding: 0;
            `;

            img.addEventListener(
                'load',
                function () {
                    alignIcon();
                }
            );

            link.appendChild(img);
            extra.appendChild(link);
        }

        /*
         * Append sau platform__wrap.
         *
         * Không đưa vào trong wrap,
         * nên APP + QR giữ nguyên layout cũ.
         */
        if (
            extra.parentElement !== platform ||
            platform.lastElementChild !== extra
        ) {
            platform.appendChild(extra);
        }

        /*
         * Reset các style từ version cũ.
         */
        extra.style.transform = 'none';
        extra.style.position = 'static';
        extra.style.right = 'auto';
        extra.style.left = 'auto';

        requestAnimationFrame(function () {
            alignIcon();
        });

        return true;
    }

    /*
     * Footer đã có thì chạy ngay.
     */
    if (!addFooterIcon()) {

        /*
         * Nếu Footer chưa render thì đợi.
         */
        const observer =
            new MutationObserver(function () {

                if (addFooterIcon()) {
                    observer.disconnect();
                }
            });

        observer.observe(
            document.body,
            {
                childList: true,
                subtree: true
            }
        );
    }

    /*
     * Responsive desktop/mobile.
     */
    window.addEventListener(
        'resize',
        function () {
            requestAnimationFrame(function () {
                alignIcon();
            });
        }
    );

    /*
     * Mobile rotate.
     */
    window.addEventListener(
        'orientationchange',
        function () {
            setTimeout(function () {
                alignIcon();
            }, 200);
        }
    );

    window.addEventListener(
        'load',
        function () {
            alignIcon();
        }
    );

})();


</script>

    
    



    
